/// Home table for all report measures.
table _Measures
	lineageTag: 9e1a0000-0000-4000-8000-000000001000

	/// Net sales in USD after discounts: quantity times net unit price, all order lines in the current filter.
	measure 'Sales Amount' = SUMX(Sales, Sales[Quantity] * Sales[Net Price])
		formatString: \$#,0
		displayFolder: Sales
		lineageTag: 9e1a0000-0000-4000-8000-000000001101

	/// Cost of goods sold in USD: quantity times standard unit cost, all order lines.
	measure 'Total Cost' = SUMX(Sales, Sales[Quantity] * Sales[Unit Cost])
		formatString: \$#,0
		displayFolder: Sales
		lineageTag: 9e1a0000-0000-4000-8000-000000001102

	/// Gross margin in USD: net sales minus cost of goods sold.
	measure Margin = [Sales Amount] - [Total Cost]
		formatString: \$#,0
		displayFolder: Profitability
		lineageTag: 9e1a0000-0000-4000-8000-000000001103

	/// Gross margin as a percentage of net sales (0.25 = 25%).
	measure 'Margin %' = DIVIDE([Margin], [Sales Amount])
		formatString: 0.0%
		displayFolder: Profitability
		lineageTag: 9e1a0000-0000-4000-8000-000000001104

	/// Net sales in USD for the same dates one year earlier, following the Date table.
	measure 'Sales PY' = CALCULATE([Sales Amount], SAMEPERIODLASTYEAR('Date'[Date]))
		formatString: \$#,0
		displayFolder: Time Intelligence
		lineageTag: 9e1a0000-0000-4000-8000-000000001105

	/// Growth of net sales versus the same period last year, as a percentage; blank when last year had no sales.
	measure 'Sales YoY %' =
			VAR CurrentSales = [Sales Amount]
			VAR PriorSales = [Sales PY]
			RETURN
				DIVIDE(CurrentSales - PriorSales, PriorSales)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence
		lineageTag: 9e1a0000-0000-4000-8000-000000001106

	/// Count of sales order lines (not orders) in the current filter.
	measure 'Order Lines' = COUNTROWS(Sales)
		formatString: #,0
		displayFolder: Volume
		lineageTag: 9e1a0000-0000-4000-8000-000000001107

	column Placeholder
		isHidden
		lineageTag: 9e1a0000-0000-4000-8000-000000001201
		summarizeBy: none
		isNameInferred
		sourceColumn: [Placeholder]

	partition _Measures = calculated
		mode: import
		source = ROW("Placeholder", BLANK())
