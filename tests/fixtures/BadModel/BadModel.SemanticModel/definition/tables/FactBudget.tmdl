table FactBudget
	lineageTag: 0b6f5c1e-1a01-4c2b-9a10-5d2e8f005000

	measure 'Budget Amount' = SUM(FactBudget[Amount])
		formatString: #,0
		lineageTag: 0b6f5c1e-1a01-4c2b-9a10-5d2e8f005101

	measure 'Budget vs Actual' = [Total Sales] - [Budget Amount]
		formatString: #,0
		lineageTag: 0b6f5c1e-1a01-4c2b-9a10-5d2e8f005102

	column Category
		dataType: string
		lineageTag: 0b6f5c1e-1a01-4c2b-9a10-5d2e8f005201
		summarizeBy: none
		sourceColumn: Category

	column Month
		dataType: dateTime
		formatString: Long Date
		lineageTag: 0b6f5c1e-1a01-4c2b-9a10-5d2e8f005202
		summarizeBy: none
		sourceColumn: Month

	column Amount
		dataType: double
		lineageTag: 0b6f5c1e-1a01-4c2b-9a10-5d2e8f005203
		summarizeBy: sum
		sourceColumn: Amount

	partition FactBudget = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("C:\Finance\Budget 2024.xlsx"), null, true),
				    Budget_Sheet = Source{[Item="Budget",Kind="Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(Budget_Sheet, [PromoteAllScalars=true])
				in
				    #"Promoted Headers"

	annotation PBI_ResultType = Table
